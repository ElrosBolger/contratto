<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- Gradiente Sfondo Dark Radar -->
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="70%">
      <stop offset="0%" stop-color="#0f1926" />
      <stop offset="100%" stop-color="#070d17" />
    </radialGradient>

    <!-- Gradiente Scudo Ciano -->
    <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>

    <!-- Bagliore Neon Aereo -->
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="8" result="blur" />
      <feMerge>
        <feMergeNode in="blur" />
        <feMergeNode in="SourceGraphic" />
      </feMerge>
    </filter>
  </defs>

  <!-- Angoli arrotondati base (Squircle Android/PWA) -->
  <rect width="512" height="512" rx="112" fill="url(#bgGrad)" />

  <!-- Cerchi Concentrici Radar Sfumati -->
  <circle cx="256" cy="256" r="190" fill="none" stroke="#1e293b" stroke-width="2" stroke-dasharray="8 6" />
  <circle cx="256" cy="256" r="130" fill="none" stroke="#1e293b" stroke-width="2" />
  <circle cx="256" cy="256" r="70" fill="none" stroke="#1e293b" stroke-width="1.5" />

  <!-- Assi Reticolo Radar -->
  <line x1="256" y1="56" x2="256" y2="456" stroke="#1e293b" stroke-width="2" />
  <line x1="56" y1="256" x2="456" y2="256" stroke="#1e293b" stroke-width="2" />

  <!-- Scudo di Sicurezza Aeroportuale (Border Ciano) -->
  <path d="M256 60 L420 125 C420 250 256 430 256 430 C256 430 92 250 92 125 Z" fill="#0b1320" stroke="url(#shieldGrad)" stroke-width="16" stroke-linejoin="round" />

  <!-- Sagoma Aereo Tattico / Security Radar (Verde Neon) -->
  <path d="M256 128 
           L290 220 
           L380 252 
           L298 286 
           L306 348 
           L256 322 
           L206 348 
           L214 286 
           L132 252 
           L222 220 Z" fill="#00ff66" filter="url(#neonGlow)" />

  <!-- Cockpit Ciano Centrale -->
  <polygon points="256,155 264,195 256,205 248,195" fill="#38bdf8" />
</svg>